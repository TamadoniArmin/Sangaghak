@page
@model SangaghakRazorEndPoint.Areas.Customer.Pages.RequestInvoiceModel
@{
    Layout = "~/Areas/Admin/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "فاکتور";
}

@using SangaghakRazorEndPoint
@namespace SangaghakRazorEndPoint.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <!-- نمایش پیام خطا -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-icon p-2" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm rounded bg-danger d-flex justify-content-center align-items-center fs-18 me-2 flex-shrink-0">
                                <i class="bx bx-error-circle text-white"></i>
                            </div>
                            <div class="flex-grow-1">
                                @TempData["ErrorMessage"]
                            </div>
                        </div>
                    </div>
                }

                <!-- Logo & title -->
                <div class="clearfix pb-3 bg-info-subtle p-lg-3 p-2 m-n2 rounded position-relative">
                    <div class="float-sm-start">
                        <div class="auth-logo">
                            <img class="logo-dark me-1" src="/images/logo-dark.png" alt="لوگو تیره" height="24" />
                        </div>
                        <div class="mt-4">
                            <h4>مدیریت سنجاقک</h4>
                            <address class="mt-3 mb-0">
                                ۱۷۲۹ خیابان بنگر،<br>
                                هولتون، ماین، ۰۴۷۳۰، ایالات متحده<br>
                                <abbr title="تلفن">تلفن:</abbr> (۱۴۲)-۵۳۲-۹۱۰۹
                            </address>
                        </div>
                    </div>
                    <div class="float-sm-end">
                        <div class="table-responsive">
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="p-0 pe-5 py-1">
                                            <p class="mb-0">تاریخ صدور:</p>
                                        </td>
                                        <td class="text-end text-dark fw-medium px-0 py-1">@DateTime.Now.ToString("dd MMMM yyyy HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pe-5 py-1">
                                            <p class="mb-0">مبلغ:</p>
                                        </td>
                                        <td class="text-end text-dark fw-medium px-0 py-1">@Model.WantedRequest.OfferPrice</td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pe-5 py-1">
                                            <p class="mb-0">وضعیت:</p>
                                        </td>
                                        <td class="text-end px-0 py-1"><span class="badge bg-warning text-white px-2 py-1 fs-13">در انتظار پرداخت</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="position-absolute top-100 start-50 translate-middle">
                        <img src="/images/check-2.png" alt="" class="img-fluid">
                    </div>
                </div>

                <div class="clearfix pb-3 mt-4">
                    <div class="float-sm-start">
                        <div class="">
                            <h4 class="card-title">اطلاعات کارشناس</h4>
                            <div class="mt-3">
                                <h4>@Model.WantedRequest.ExpertFullName</h4>
                                <p class="mb-2"><span class="text-decoration-underline">تلفن:</span> @Model.WantedRequest.ExpertPhone</p>
                                <p class="mb-2"><span class="text-decoration-underline">ایمیل:</span> @Model.WantedRequest.ExpertEmail</p>
                            </div>
                        </div>
                    </div>
                    <div class="float-sm-end">
                        <div class="">
                            <h4 class="card-title">اطلاعات مشتری</h4>
                            <div class="mt-3">
                                <h4>@Model.WantedRequest.CustomerFullName</h4>
                                <p class="mb-2"><span class="text-decoration-underline">تلفن:</span> @Model.WantedRequest.CustomerPhone</p>
                                <p class="mb-2"><span class="text-decoration-underline">ایمیل:</span> @Model.WantedRequest.CustomerEmail</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row justify-content-end">
                    <div class="col-lg-5 col-6">
                        <div class="table-responsive">
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-end p-0 pe-5 py-2">
                                            <p class="mb-0">مزد کارشناس</p>
                                        </td>
                                        <td class="text-end text-dark fw-medium py-2">@Model.WantedRequest.OfferPrice</td>
                                    </tr>
                                    <tr>
                                        <td class="text-end p-0 pe-5 py-2">
                                            <p class="mb-0">سود شرکت (10٪):</p>
                                        </td>
                                        <td class="text-end text-dark fw-medium py-2">@Model.CompanyProfit</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="text-end p-0 pe-5 py-2">
                                            <p class="mb-0 text-dark fw-semibold">مبلغ کل:</p>
                                        </td>
                                        <td class="text-end text-dark fw-semibold py-2">@Model.TotalCost</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-12">
                        <div class="alert alert-danger alert-icon p-2" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm rounded bg-danger d-flex justify-content-center align-items-center fs-18 me-2 flex-shrink-0">
                                    <i class="bx bx-info-circle text-white"></i>
                                </div>
                                <div class="flex-grow-1">
                                    تمام حساب‌ها باید ظرف ۷ روز از دریافت فاکتور پرداخت شوند. پرداخت باید از طریق چک، کارت اعتباری یا پرداخت مستقیم آنلاین انجام شود. در صورت عدم پرداخت حساب ظرف ۷ روز، جزئیات اعتباری ارائه شده به عنوان تأیید کار انجام شده به مبلغ توافقی ذکر شده در بالا، کسر خواهد شد.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 mb-1">
                    <div class="text-end d-print-none">

                        <a asp-page-handler="Pay" asp-route-requestId="@Model.WantedRequest.Id" asp-route-OfferedPrice="@Model.WantedRequest.OfferPrice" class="btn btn-outline-primary width-xl">پرداخت</a>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
