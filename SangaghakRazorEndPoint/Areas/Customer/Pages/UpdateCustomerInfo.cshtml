@page
@model SangaghakRazorEndPoint.Areas.Customer.Pages.UpdateCustomerInfoModel
@{
    Layout = "~/Areas/Admin/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "ویرایش اطلاعات کاربر";
}

@using SangaghakRazorEndPoint
@namespace SangaghakRazorEndPoint.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers




<div class="row">
    <div class="col-xl-9 col-lg-8">
        <form enctype="multipart/form-data" role="form" method="post" asp-page-handler="UpdateUser">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">ویرایش اطلاعات کاربر</h4>
                </div>
                <div class="card-body">
                    <div class="row">

                        <div class="dropzone bg-light-subtle py-5">
                            <div class="form-group relative">
                                <input asp-for="UserToUpdate.ProfileImgFile" type="file" class="form-control">
                                <label>آپلود عکس</label>
                                <div class="input-group round">
                                    <input type="text" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                                    <span class="input-group-btn">
                                        <button type="button" class="btn btn-success">
                                            <i class="icon-picture"></i>
                                            آپلود عکس
                                            <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                                        </button>
                                    </span>
                                </div><!-- /.input-group -->
                                <div class="help-block"></div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="brand-title" class="form-label">نام</label>
                                <input asp-for="@Model.UserToUpdate.FirstName" type="text"
                                       id="brand-title"
                                       class="form-control"
                                       placeholder="نام"
                                       value="@(Model.PriorUserinfo?.FirstName ?? "")" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="brand-title" class="form-label">نام خانوادگی</label>
                                <input asp-for="@Model.UserToUpdate.LastName" type="text"
                                       id="brand-title"
                                       class="form-control"
                                       placeholder="نام خانوادگی"
                                       value="@(Model.PriorUserinfo?.LastName ?? "")" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="username" class="form-label">نام کاربری</label>
                                <input asp-for="@Model.UserToUpdate.UserName" type="text"
                                       id="username"
                                       class="form-control"
                                       placeholder="نام کاربری"
                                       value="@(Model.PriorUserinfo?.UserName ?? "")" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="username" class="form-label">نام کاربری</label>
                                <input asp-for="@Model.UserToUpdate.Email" type="text"
                                       id="username"
                                       class="form-control"
                                       placeholder="نام کاربری"
                                       value="@(Model.PriorUserinfo?.Email ?? "")" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <label for="product-categories" class="form-label">شهر</label>
                            <select asp-for="@Model.UserToUpdate.CityId" class="form-select"
                                    data-placeholder="یک شهر انتخاب کیند">
                                <option value="@Model.PriorUserinfo.CityId">یک شهر انتخاب کنید</option>
                                @if (Model.Cities != null)
                                {
                                    @foreach (var city in Model.Cities)
                                    {

                                        <option value="@city.Id">@city.Title</option>

                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label for="seller-number" class="form-label">شماره تلفن</label>
                            <div class="input-group mb-3">
                                <span class="input-group-text fs-20">
                                    <iconify-icon icon="solar:outgoing-call-rounded-bold-duotone" class="fs-20"></iconify-icon>
                                </span>
                                <input asp-for="@Model.UserToUpdate.Mobile" type="text"
                                       id="seller-number"
                                       class="form-control"
                                       placeholder="09*********"
                                       value="@(Model.PriorUserinfo?.Mobile ?? "")" />
                            </div>
                            <div class="p-3 bg-light mb-3 rounded">
                                <div class="row justify-content-end g-2">
                                    <div class="col-lg-2">
                                        <button type="submit" class="btn btn-outline-secondary w-100">ذخیره تغییرات</button>
                                    </div>
                                    <div class="col-lg-2">
                                        <a href="" class="btn btn-primary w-100">لغو</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    
</div>






