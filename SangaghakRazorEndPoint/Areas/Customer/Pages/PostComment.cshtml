@page
@model SangaghakRazorEndPoint.Areas.Customer.Pages.PostCommentModel
@{
    Layout = "~/Areas/Admin/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "صفحه ی نوشتن کامنت";
}

@using SangaghakRazorEndPoint
@namespace SangaghakRazorEndPoint.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="col-lg-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">ثبت کامنت</h4>
        </div>
        <div class="card-body">
            <form enctype="multipart/form-data" role="form" method="post" asp-page-handler="CreateComment">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-3">
                            <label for="comment" class="form-label text-dark">کامنت مشتری</label>
                            <textarea asp-for="@Model.NewComment.Description" class="form-control" id="comment" placeholder="کامنت خود را وارد کنید" onblur="if(this.value.trim() === '') this.value = 'متنی توسط مشتری وارد نشده است';"></textarea>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="">
                            <label for="rating" class="form-label">امتیاز</label>
                            <select asp-for="@Model.NewComment.Rate" class="form-control" id="rating" data-choices data-choices-groups data-placeholder="امتیاز را انتخاب کنید" onchange="if(this.value === '') this.value = '3';">
                                <option value="">انتخاب کنید</option>
                                <option value="5">خیلی خوب</option>
                                <option value="4">خوب</option>
                                <option value="3" selected>متوسط</option>
                                <option value="2">ضعیف</option>
                                <option value="1">بد</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer border-top">
                    <button type="submit" class="btn btn-primary">ثبت تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>