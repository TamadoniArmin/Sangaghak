@page
@model SangaghakRazorEndPoint.Areas.Customer.Pages.SeeExpertProfileModel
@{
    Layout = "~/Areas/Admin/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "صفحه ی مشاهده ی پروفایل کارشناس";
}

@using SangaghakRazorEndPoint
@namespace SangaghakRazorEndPoint.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <!--قسمت اطلاعات کاربر-->
                    <div class="col-lg-2 text-lg-center">
                        <div class="bg-body d-flex align-items-center justify-content-center rounded py-4">
                            @if (Model.WantedUser.ImagePath != null)
                            {
                                <img src="@Model.WantedUser.ImagePath" alt="" class="avatar-md">
                            }
                            else
                            {
                                <img src="~/Images/Profiles/dummy-avatar.jpg" alt="" class="avatar-md">
                            }
                        </div>
                    </div>
                    <div class="col-lg-3 border-end">
                        <div class="">
                            <h4 class="mb-1">@Model.WantedUser.FullName</h4>
                            <p class="mb-1">(کارشناس)</p>
                            <div class="d-flex align-items-center justify-content-start gap-2 mt-2 mb-1">
                                <ul class="d-flex text-warning m-0 fs-20 list-unstyled">
                                    @if (Model.ExpertRate >= 1)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Model.ExpertRate == 2)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Model.ExpertRate == 3)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Model.ExpertRate == 4)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Model.ExpertRate == 5)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                </ul>
                                <p class="fw-medium mb-0 text-dark fs-15">
                                    ۴.۵/۵ <span class="fs-13">(۲۳.۳K بررسی)</span>
                                </p>
                            </div>
                            <div class="mt-2">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
                                        <iconify-icon icon="solar:point-on-map-bold-duotone"
                                                      class="fs-20 text-primary"></iconify-icon>
                                    </div>
                                    <p class="mb-0 fs-15">@Model.WantedUser.CityName</p>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
                                        <iconify-icon icon="solar:letter-bold-duotone"
                                                      class="fs-20 text-primary"></iconify-icon>
                                    </div>
                                    <p class="mb-0 fs-15">@Model.WantedUser.Email</p>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
                                        <iconify-icon icon="solar:outgoing-call-rounded-bold-duotone"
                                                      class="fs-20 text-primary"></iconify-icon>
                                    </div>
                                    <p class="mb-0 fs-15">@Model.WantedUser.Mobile</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--تا اینجا-->
                    <!--شروع قسمت تخصص کارشناس و درخواست های متناسب-->
                    <div class="col-lg-7">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">تخصص ها</h4>
                            </div>
                            <div class="card-body">
                                <div class="row g-2 mt-2 mb-4">
                                    <div class="col-lg-6">
                                        <div class="border p-3 rounded">
                                            <h4 class="card-title">تخصص های کارشناس</h4>
                                            @if (Model.ExpertSkillsNames.any())
                                            {
                                                @foreach (var Skill in Model.ExpertSkillsNames)
                                                {
                                                    <div class="d-flex gap-2 flex-wrap mt-3">
                                                        <span class="badge bg-body text-muted px-2 py-1 fs-12">#@Skill.SubcategoryNames</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--پایان قسمت تخصص های کارشناس و درخواست های متناسب-->
                </div>
            </div>
        </div>
    </div>
</div>

<!--شروع قسمت کامنت ها-->
<div class="row">
    @if (Model.ExpertComments != null)
    {
        @foreach (var Comment in Model.ExpertComments)
        {
            <div class="col-md-6 col-xl-3">
                <div class="card">
                    <img src="/images/product/p-1.png" alt="" class="img-fluid ">
                    <div class="card-body bg-light-subtle rounded-bottom">
                        <p class="text-dark fw-medium fs-16">
                            @Comment.CustomerName
                        </p>
                        <div class="my-1">
                            <div class="d-flex gap-2 align-items-center">
                                <ul class="d-flex text-warning m-0 fs-18 list-unstyled">
                                    @if (Comment.Rate.(int)Math.Ceiling().(int)Math.Ceiling() >= 1)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Comment.Rate.(int)Math.Ceiling() == 2)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Comment.Rate.(int)Math.Ceiling() == 3)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Comment.Rate.(int)Math.Ceiling() == 4)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                    @if (Comment.Rate.(int)Math.Ceiling() <= 5)
                                    {
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                        <li>
                                            <i class="bx bxs-star"></i>
                                        </li>
                                    }
                                </ul>
                                <p class="mb-0 fw-medium fs-15 text-dark">
                                    @Comment.PackageTiltle
                                </p>
                            </div>
                        </div>
                        <h4 class="fw-semibold text-dark mt-2 d-flex align-items-center gap-2">
                            @Comment.Description
                        </h4>
                    </div>

                </div>
            </div>
        }
    }
</div>
<!--پایان قسمت کامنت ها-->
