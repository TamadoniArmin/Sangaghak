@page
@model SangaghakRazorEndPoint.Areas.Admin.Pages.CommentManagerModel
@{
}
@using App.Domain.Core.Sangaghak.Enum
@using SangaghakRazorEndPoint
@namespace SangaghakRazorEndPoint.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers




<div class="row">
    @if (Model.Comments is not null)
    {
        @foreach (var comment in Model.Comments)
        {
            <div class="col-xl-3 col-md-6">
                <div class="card overflow-hidden">
                    <div class="card-body">
                        <p class="mb-2 text-dark fw-semibold fs-15">@comment.CustomerName</p>
                        <p class="mb-2 text-dark fw-semibold fs-15">@comment.SetAt</p>
                        <p class="mb-0">@comment.Description</p>
                        <div class="d-flex align-items-center gap-2 mt-2 mb-1">
                            <ul class="d-flex text-warning m-0 fs-20 list-unstyled">
                                @for (int i = 1; i <= comment.Rate; i++)
                                {
                                    <li>
                                        <i class="bx bxs-star"></i>
                                    </li>
                                }
                            </ul>
                            @if (comment.Rate == 1)
                            {
                                <p class="fw-medium mb-0 text-dark fs-15">بسیار بد</p>
                            }
                            @if (comment.Rate == 2)
                            {
                                <p class="fw-medium mb-0 text-dark fs-15">ضعیف</p>
                            }
                            @if (comment.Rate == 3)
                            {
                                <p class="fw-medium mb-0 text-dark fs-15">متوسط</p>
                            }
                            @if (comment.Rate == 4)
                            {
                                <p class="fw-medium mb-0 text-dark fs-15">خوب</p>
                            }
                            @if (comment.Rate == 5)
                            {
                                <p class="fw-medium mb-0 text-dark fs-15">بسیار عالی</p>
                            }

                        </div>
                        <div class="mt-3">
                            <div class="d-flex gap-2">
                                <div class="dropdown">
                                    <a href="#" class="btn btn-soft-primary border border-primary-subtle" data-bs-toggle="dropdown" aria-expanded="false"><i class='bx bx-dots-horizontal-rounded'></i></a>
                                    <div class="dropdown-menu">

                                        <a asp-page-handler="UpdateComment" asp-route-CommentId="@comment.Id" asp-route-Status="@Model.CommentAccepted" class="btn btn-soft-primary btn-sm">تایید</a>

                                        <a asp-page-handler="UpdateComment" asp-route-CommentId="@comment.Id" asp-route-Status="@Model.CommentNotAccepted" class="btn btn-soft-danger btn-sm">رد</a>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-primary position-relative mt-3">
                        <div class="mt-4">
                            <h4 class="text-white mb-1">@comment.ExpertName</h4>
                            <p class="text-white mb-0">@comment.PackageTiltle / @comment.CityName</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

</div>



