<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="keywords" content="HTML5,CSS3,HTML,Template,multi-page,Zoben - Job Board HTML Template">
    <meta name="description" content="Zoben - Job Board HTML Template">
    <meta name="author" content="Barat Hadian">
    <link rel="stylesheet" href="~/MainTemplate/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/animate.min.css">
    <link rel="stylesheet" href="~/MainTemplate/fonts/remixicon.css">
    <link rel="stylesheet" href="~/MainTemplate/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/metismenu.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/simplebar.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/dropzone.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/magnific-popup.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/odometer.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/meanmenu.min.css">
    <link rel="stylesheet" href="~/MainTemplate/css/style.css">
    <link rel="stylesheet" href="~/MainTemplate/css/responsive.css">
    <link rel="stylesheet" href="~/MainTemplate/css/theme-dark.css">
    <link rel="stylesheet" href="~/MainTemplate/css/rtl.css">
    <title>Zoben - قالب HTML زوبن , پوسته سایت آگهی و کاریابی</title>
    <link rel="icon" type="image/png" href="~/MainTemplate/images/favicon.png">
</head>
<body>
    <div class="preloader">
        <div class="d-table">
            <div class="d-table-cell">
                <div class="spinner"></div>
            </div>
        </div>
    </div>

    <div class="navbar-area">
        <div class="mobile-responsive-nav">
            <div class="container-fluid">
                <div class="mobile-responsive-menu">
                    <div class="logo">
                        <a href="index.html">
                            <img src="~/MainTemplate/images/logo.png" class="logo-one" alt="logo"><img src="~/MainTemplate/images/logo-2.png" class="logo-two" alt="Logo">
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="desktop-nav desktop-nav-one nav-area">
            <div class="container-fluid">
                <nav class="navbar navbar-expand-md navbar-light">
                    <a class="navbar-brand" href="index.html">
                        <img src="~/MainTemplate/images/logo.png" class="logo-one" alt="logo"><img src="~/MainTemplate/images/logo-2.png" class="logo-two" alt="Logo">
                    </a>
                    <div class="collapse navbar-collapse mean-menu" id="navbarSupportedContent">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link active">
                                    خانه
                                    <i class="ri-arrow-down-s-line"></i>
                                </a>
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <ul class="dropdown-menu">
                                        <li class="nav-item">
                                            <a asp-page="/Index" class="nav-link">
                                                بازگشت به صفحه ی اصلی
                                            </a>
                                        </li>
                                    </ul>
                                    <ul class="dropdown-menu">
                                        <li class="nav-item">
                                            @{
                                                var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                                                string profileArea = role switch
                                                {
                                                    "Admin" => "Admin",
                                                    "Customer" => "Customer",
                                                    "Expert" => "Expert",
                                                    _ => "" // برای هدایت به Access Denied
                                                };
                                                string profilePage = role switch
                                                {
                                                    "Admin" => "/Index",
                                                    "Customer" => "/Index",
                                                    "Expert" => "/Index",
                                                    _ => "/Account/AccessDenied" // صفحه Access Denied
                                                };
                                            }
                                            <a asp-area="@profileArea" asp-page="@profilePage" class="nav-link">
                                                پروفایل کاربری
                                            </a>
                                        </li>
                                    </ul>
                                }
                            </li>
                        </ul>
                        <div class="others-options d-flex align-items-center">
                            <div class="optional-item">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    @await Component.InvokeAsync("UserProfile")
                                }
                                else
                                {
                                    <a asp-page="/Login" class="default-btn two border-radius-5">ورود / ثبت نام <i class="ri-user-3-line"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
        <div class="side-nav-responsive">
            <div class="container-max">
                <div class="dot-menu">
                    <div class="circle-inner">
                        <div class="circle circle-one"></div>
                        <div class="circle circle-two"></div>
                        <div class="circle circle-three"></div>
                    </div>
                </div>
                <div class="container">
                    <div class="side-nav-inner">
                        <div class="side-nav justify-content-center align-items-center">
                            <div class="side-nav-item">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    @await Component.InvokeAsync("UserProfile")
                                }
                                else
                                {
                                    <a asp-page="/Login" class="default-btn two">
                                        ورود / ثبت نام <i class="ri-user-3-line"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @RenderBody()

    <footer class="footer-area">
        <div class="container">
            <div class="footer-top pt-100 pb-70">
                <div class="row">
                    <div class="col-lg-3 col-sm-6 col-md-6">
                        <div class="footer-widget">
                            <div class="footer-logo">
                                <a href="index.html">
                                    <img src="~/MainTemplate/images/logo.png" class="footer-logo1" alt="Footer Logo"><img src="~/MainTemplate/images/logo-2.png" class="footer-logo2" alt="Footer Logo">
                                </a>
                            </div>
                            <ul class="footer-contact-list">
                                <li>
                                    <i class="ri-map-pin-line"></i>
                                    <div class="content">
                                        <a href="https://goo.gl/maps/muUSCY6FnusqhrGK9">
                                            ایران استان تهران میدان آزادی
                                        </a>
                                    </div>
                                </li>
                                <li>
                                    <i class="ri-mail-line"></i>
                                    <div class="content">
                                        <a href="mailto: hello@zoben.com"> hello@zoben.com</a>
                                    </div>
                                </li>
                                <li>
                                    <i class="ri-phone-line"></i>
                                    <div class="content">
                                        <a href="tel:+4471234567890">
                                            +44 4325 9878 5875
                                        </a>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copyright-area">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-md-7">
                        <div class="copy-right-text">
                            <p>کپی رایت © 1403 زوبن. تمام حقوق قالب محفوظ است. طراحی توسط <a href="#" target="_blank">Barat Hadian</a></p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-5">
                        <div class="copy-right-social-link">
                            <ul class="social-link">
                                <li>
                                    <a href="https://www.facebook.com/" target="_blank">
                                        <i class="ri-facebook-fill"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.instagram.com/" target="_blank">
                                        <i class="ri-instagram-fill"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://twitter.com/" target="_blank">
                                        <i class="ri-twitter-fill"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.linkedin.com/" target="_blank">
                                        <i class="ri-linkedin-fill"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/MainTemplate/js/jquery.min.js"></script>
    <script src="~/MainTemplate/js/bootstrap.bundle.min.js"></script>
    <script src="~/MainTemplate/js/jquery.magnific-popup.min.js"></script>
    <script src="~/MainTemplate/js/odometer.min.js"></script>
    <script src="~/MainTemplate/js/jquery.appear.min.js"></script>
    <script src="~/MainTemplate/js/meanmenu.min.js"></script>
    <script src="~/MainTemplate/js/metismenu.min.js"></script>
    <script src="~/MainTemplate/js/simplebar.min.js"></script>
    <script src="~/MainTemplate/js/dropzone.min.js"></script>
    <script src="~/MainTemplate/js/sticky-sidebar.min.js"></script>
    <script src="~/MainTemplate/js/tweenMax.min.js"></script>
    <script src="~/MainTemplate/js/owl.carousel.min.js"></script>
    <script src="~/MainTemplate/js/jquery.ajaxchimp.min.js"></script>
    <script src="~/MainTemplate/js/form-validator.min.js"></script>
    <script src="~/MainTemplate/js/contact-form-script.js"></script>
    <script src="~/MainTemplate/js/custom.js"></script>
</body>
</html>