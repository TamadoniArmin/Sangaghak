@page
@model SangaghakRazorEndPoint.Areas.Public.Pages.IndexModel
@{
}
@using SangaghakRazorEndPoint
@namespace SangaghakRazorEndPoint.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="banner-area-three">
    <div class="container">
        <div class="banner-content-three">
            <h1 class="wow fadeInUp" data-wow-delay="000ms" data-wow-duration="1000ms">به سنجاقک خوش آمدید.</h1>
            <div class="banner-three-other">
                <div class="other-content1 wow fadeInUp" data-wow-delay="300ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/user2.jpg" alt="Images">
                </div>
                <div class="other-content2 wow fadeInUp" data-wow-delay="400ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/home-three-icon2.png" alt="Images">
                </div>
                <div class="other-content3 wow fadeInDown" data-wow-delay="500ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/user1.jpg" alt="Images">
                </div>
                <div class="other-content4 wow fadeInDown" data-wow-delay="600ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/home-three-shape1.jpg" alt="Images">
                </div>
                <div class="other-content5 wow fadeInUp" data-wow-delay="700ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/home-three-icon4.png" alt="Images">
                </div>
                <div class="other-content6 wow fadeInDown" data-wow-delay="800ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/home-three-icon1.png" alt="Images">
                </div>
                <div class="other-content7 wow fadeInDown" data-wow-delay="900ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/home-three-shape2.jpg" alt="Images">
                </div>
                <div class="other-content8 wow fadeInDown" data-wow-delay="1000ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/user4.jpg" alt="Images">
                </div>
                <div class="other-content9 wow fadeInDown" data-wow-delay="1100ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/user3.jpg" alt="Images">
                    <div class="other-into-content">
                        <img src="~/MainTemplate/images/home-three/home-three-shape1.jpg" alt="Images">
                    </div>
                </div>
                <div class="other-content10 wow fadeInDown" data-wow-delay="1200ms" data-wow-duration="1000ms">
                    <img src="~/MainTemplate/images/home-three/home-three-icon3.png" alt="Images">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="browse-jobs-area-two pt-100 pb-70">
    <div class="container">
        <div class="section-title text-center">
            <h2>مرور دسته بندی های اصلی</h2>
            <div class="bar m-auto"></div>
        </div>
        <div class="row pt-45">
            @foreach (var Category in Model.Categories)
            {
                <div class="col-lg-3 col-6">
                    <div class="browse-jobs-item">
                        @if (Category.ImagePath != null)
                        {
                            <img src="@Category.ImagePath" alt="Images">
                        }
                        else
                        {
                            <img src="assets/images/find-jobs/find-jobs1.jpg" alt="Images">
                        }
                        <h3><a asp-page="SeeCategoryDetails" asp-route-CategoryId="@Category.Id">@Category.Title</a></h3>
                    </div>
                </div>
            }
        </div>
    </div>
</div>